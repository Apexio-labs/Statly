{
  "name": "statly",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@12.16.1",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "pnpm --filter @statly/web dev",
    "build": "pnpm --filter @statly/card-viewer build && pnpm --filter @statly/web build && pnpm --filter @statly/mcp-bridge build",
    "contract": "pnpm --filter @statly/contract generate",
    "lint": "biome check .",
    "format": "biome check --write .",
    "typecheck": "pnpm -r typecheck",
    "test": "pnpm -r test"
  },
  "devDependencies": {
    "@biomejs/biome": "2.6.4",
    "typescript": "7.0.2",
    "vite": "8.3.5"
  }
}
